rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for User profile
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('role' in data) || (data.role is string && (data.role == 'freelancer' || data.role == 'designer' || data.role == 'client')));
    }

    // Validation for File Record
    function isValidFileRecord(data) {
      return data.keys().hasAll(['id', 'userId', 'fileName', 'fileSize', 'fileType', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'fileName', 'fileSize', 'fileType', 'fileUrl', 'storagePath', 'clientName', 'category', 'notes', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 255 &&
        data.fileSize is number && data.fileSize >= 0 &&
        data.fileType is string && data.fileType.size() <= 120 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('fileUrl' in data) || (data.fileUrl is string && data.fileUrl.size() <= 500000)) &&
        (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 500)) &&
        (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 100)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'role']);
      allow delete: if false;
    }

    // Files collection
    match /files/{fileId} {
      allow get: if isSignedIn() && isValidId(fileId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(fileId) && incoming().id == fileId && incoming().userId == request.auth.uid && isValidFileRecord(incoming());
      allow update: if isSignedIn() && isValidId(fileId) && resource.data.userId == request.auth.uid &&
        isValidFileRecord(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().id == existing().id &&
        incoming().fileSize == existing().fileSize &&
        incoming().fileType == existing().fileType &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['fileName', 'clientName', 'category', 'notes', 'fileUrl', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(fileId) && resource.data.userId == request.auth.uid;
    }
  }
}
