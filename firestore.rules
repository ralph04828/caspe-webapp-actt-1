rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'theme', 'stylePreference', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 100000)) &&
        (!('theme' in data) || (data.theme is string && (data.theme == 'dark' || data.theme == 'light'))) &&
        (!('stylePreference' in data) || (data.stylePreference is string && data.stylePreference.size() <= 80)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidClothingItem(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'category', 'brand', 'color', 'size', 'price', 'wearCount', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'name', 'category', 'brand', 'color', 'size', 'price', 'purchaseDate', 'description', 'imageUrl', 'storagePath', 'wearCount', 'lastWornAt', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 160 &&
        data.category is string && data.category in ['T-shirts', 'Shirts', 'Hoodies', 'Jackets', 'Pants', 'Shorts', 'Jorts', 'Shoes', 'Sneakers', 'Slides', 'Accessories', 'Other'] &&
        data.brand is string && data.brand.size() <= 100 &&
        data.color is string && data.color.size() <= 60 &&
        data.size is string && data.size.size() <= 32 &&
        data.price is number && data.price >= 0 &&
        data.wearCount is number && data.wearCount >= 0 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('purchaseDate' in data) || (data.purchaseDate is string && data.purchaseDate.size() <= 64)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500000)) &&
        (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 500)) &&
        (!('lastWornAt' in data) || (data.lastWornAt is string && data.lastWornAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidOutfit(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'styleCategory', 'isFavorite', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'name', 'styleCategory', 'description', 'topId', 'bottomId', 'shoesId', 'accessoryIds', 'coverImageUrl', 'storagePath', 'isFavorite', 'source', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 160 &&
        data.styleCategory is string && data.styleCategory.size() <= 80 &&
        data.isFavorite is bool &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('topId' in data) || (data.topId is string && data.topId.size() <= 128)) &&
        (!('bottomId' in data) || (data.bottomId is string && data.bottomId.size() <= 128)) &&
        (!('shoesId' in data) || (data.shoesId is string && data.shoesId.size() <= 128)) &&
        (!('accessoryIds' in data) || (data.accessoryIds is list && data.accessoryIds.size() <= 10)) &&
        (!('coverImageUrl' in data) || (data.coverImageUrl is string && data.coverImageUrl.size() <= 500000)) &&
        (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 500)) &&
        (!('source' in data) || (data.source is string && (data.source == 'builder' || data.source == 'ai'))) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidWishlistItem(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'brand', 'category', 'price', 'isPurchased', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'name', 'brand', 'category', 'price', 'productUrl', 'notes', 'imageUrl', 'storagePath', 'isPurchased', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 160 &&
        data.brand is string && data.brand.size() <= 100 &&
        data.category is string && data.category.size() <= 60 &&
        data.price is number && data.price >= 0 &&
        data.isPurchased is bool &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('productUrl' in data) || (data.productUrl is string && data.productUrl.size() <= 1000)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500000)) &&
        (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 500)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidOutfitSchedule(data) {
      return data.keys().hasAll(['id', 'userId', 'date', 'outfitId', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'date', 'outfitId', 'notes', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.date is string && data.date.size() >= 8 && data.date.size() <= 20 &&
        data.outfitId is string && isValidId(data.outfitId) &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'theme', 'stylePreference', 'updatedAt']);
      allow delete: if false;
    }

    // Wardrobe collection
    match /wardrobe/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(itemId) && incoming().id == itemId && isValidClothingItem(incoming());
      allow update: if isSignedIn() && isValidId(itemId) && resource.data.userId == request.auth.uid &&
        isValidClothingItem(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(itemId) && resource.data.userId == request.auth.uid;
    }

    // Outfits / Lookbook collection
    match /outfits/{outfitId} {
      allow get: if isSignedIn() && isValidId(outfitId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(outfitId) && incoming().id == outfitId && isValidOutfit(incoming());
      allow update: if isSignedIn() && isValidId(outfitId) && resource.data.userId == request.auth.uid &&
        isValidOutfit(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(outfitId) && resource.data.userId == request.auth.uid;
    }

    // Wishlist collection
    match /wishlist/{wishId} {
      allow get: if isSignedIn() && isValidId(wishId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(wishId) && incoming().id == wishId && isValidWishlistItem(incoming());
      allow update: if isSignedIn() && isValidId(wishId) && resource.data.userId == request.auth.uid &&
        isValidWishlistItem(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(wishId) && resource.data.userId == request.auth.uid;
    }

    // Outfit Schedules collection
    match /schedules/{scheduleId} {
      allow get: if isSignedIn() && isValidId(scheduleId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(scheduleId) && incoming().id == scheduleId && isValidOutfitSchedule(incoming());
      allow update: if isSignedIn() && isValidId(scheduleId) && resource.data.userId == request.auth.uid &&
        isValidOutfitSchedule(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(scheduleId) && resource.data.userId == request.auth.uid;
    }
  }
}
