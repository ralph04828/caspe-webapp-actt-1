rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isFollowerOf(targetUserId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + targetUserId)) &&
        get(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + targetUserId)).data.status == 'accepted';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function canViewVisibility(ownerId, visibility) {
      return isOwner(ownerId) ||
        visibility == 'public' ||
        (visibility == 'followers' && isFollowerOf(ownerId));
    }

    function parentMedia(mediaId) {
      return get(/databases/$(database)/documents/media/$(mediaId)).data;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) &&
        incoming().uid == request.auth.uid &&
        incoming().usernameLower is string &&
        incoming().usernameLower.size() >= 3 &&
        incoming().usernameLower.size() <= 24;
      allow update: if isSignedIn() && (
        isOwner(userId) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'followingCount', 'postsCount'])
      );
      allow delete: if isOwner(userId);
    }

    // Unique Username Registry
    match /usernames/{usernameLower} {
      allow get: if true;
      allow create: if isSignedIn() &&
        incoming().uid == request.auth.uid &&
        usernameLower.size() >= 3 &&
        usernameLower.size() <= 24;
      allow delete: if isSignedIn() && existing().uid == request.auth.uid;
    }

    // Compressed WebP Media Assets (Firestore image storage, <1 MiB per doc)
    match /media/{mediaId} {
      allow get: if canViewVisibility(existing().ownerId, existing().visibility);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(mediaId) &&
        incoming().ownerId == request.auth.uid &&
        incoming().id == mediaId &&
        incoming().visibility in ['public', 'followers', 'private'] &&
        incoming().contentType in ['image/webp', 'image/jpeg', 'image/png'] &&
        incoming().width is int &&
        incoming().width > 0 &&
        incoming().width <= 1000 &&
        incoming().height is int &&
        incoming().height > 0 &&
        incoming().height <= 1000 &&
        incoming().thumbWidth is int &&
        incoming().thumbWidth > 0 &&
        incoming().thumbWidth <= 256 &&
        incoming().thumbHeight is int &&
        incoming().thumbHeight > 0 &&
        incoming().thumbHeight <= 256 &&
        incoming().byteSize is int &&
        incoming().byteSize > 0 &&
        incoming().byteSize <= 780000 &&
        incoming().fullDataUrl is string &&
        incoming().thumbDataUrl is string;
      allow update: if isSignedIn() &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().visibility in ['public', 'followers', 'private'] &&
        incoming().diff(existing()).affectedKeys().hasOnly(['visibility', 'updatedAt']);
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;

      // Chunk subcollection for edge cases where full WebP exceeds single-doc threshold
      match /chunks/{chunkId} {
        allow get: if chunkId.matches('^[0-9]+$') &&
          exists(/databases/$(database)/documents/media/$(mediaId)) &&
          canViewVisibility(parentMedia(mediaId).ownerId, parentMedia(mediaId).visibility);
        allow list: if isSignedIn() &&
          exists(/databases/$(database)/documents/media/$(mediaId)) &&
          parentMedia(mediaId).ownerId == request.auth.uid;
        allow create: if isSignedIn() &&
          chunkId.matches('^[0-9]+$') &&
          exists(/databases/$(database)/documents/media/$(mediaId)) &&
          parentMedia(mediaId).ownerId == request.auth.uid &&
          incoming().index is int &&
          incoming().index >= 0 &&
          incoming().index < 8 &&
          incoming().data is string &&
          incoming().byteSize is int &&
          incoming().byteSize > 0 &&
          incoming().byteSize <= 500000;
        allow delete: if isSignedIn() &&
          exists(/databases/$(database)/documents/media/$(mediaId)) &&
          parentMedia(mediaId).ownerId == request.auth.uid;
      }
    }

    // Digital Wardrobe
    match /wardrobe/{itemId} {
      allow read: if canViewVisibility(existing().userId, existing().visibility);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().name is string && incoming().name.size() <= 140;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Outfits & Lookbook
    match /outfits/{outfitId} {
      allow read: if canViewVisibility(existing().userId, existing().visibility);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().name is string && incoming().name.size() <= 140;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Social Feed Posts
    match /posts/{postId} {
      allow read: if canViewVisibility(existing().userId, existing().visibility);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().caption is string && incoming().caption.size() <= 1000;
      allow update: if isSignedIn() && (
        (existing().userId == request.auth.uid && incoming().userId == existing().userId) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'savesCount', 'remixesCount'])
      );
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Likes
    match /postLikes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Saves (private to the saver)
    match /postSaves/{saveId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Comments (with optional compact media attachment references)
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().text is string &&
        incoming().text.size() >= 1 &&
        incoming().text.size() <= 1000 &&
        (!('imageUrl' in incoming()) || (incoming().imageUrl is string && incoming().imageUrl.size() <= 160)) &&
        (!('thumbUrl' in incoming()) || (incoming().thumbUrl is string && incoming().thumbUrl.size() <= 160)) &&
        (!('mediaId' in incoming()) || (incoming().mediaId is string && incoming().mediaId.size() <= 128)) &&
        (!('altText' in incoming()) || (incoming().altText is string && incoming().altText.size() <= 240));
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || existing().postAuthorId == request.auth.uid);
    }

    // Follows & Follow Requests
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().followerId == request.auth.uid;
      allow update: if isSignedIn() && existing().targetId == request.auth.uid;
      allow delete: if isSignedIn() && (existing().followerId == request.auth.uid || existing().targetId == request.auth.uid);
    }

    // Notifications (recipient-only read/update; signed-in actor can create)
    match /notifications/{notifId} {
      allow read: if isSignedIn() && existing().recipientId == request.auth.uid;
      allow create: if isSignedIn() && incoming().actorId == request.auth.uid;
      allow update: if isSignedIn() && existing().recipientId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && existing().recipientId == request.auth.uid;
    }

    // Safety: Blocks & Mutes (strictly owner-only)
    match /userBlocks/{blockId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /userMutes/{muteId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Safety Reports
    match /reports/{reportId} {
      allow create: if isSignedIn() && incoming().reporterId == request.auth.uid;
      allow read: if isSignedIn() && existing().reporterId == request.auth.uid;
    }

    // Wishlist (private by default, toggleable)
    match /wishlist/{wishId} {
      allow read: if canViewVisibility(existing().userId, existing().visibility);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().name is string && incoming().name.size() <= 140;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Private Schedules & Wear Logs (Strictly Owner-Only)
    match /schedules/{scheduleId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /wearLogs/{logId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Shareable Lookbook / Outfit Links
    match /shareLinks/{token} {
      allow get: if existing().visibility != 'revoked' || isOwner(existing().userId);
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Daily AI Quotas (Owner-readable & server-mirrored)
    match /aiQuotas/{quotaId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
    }
  }
}
